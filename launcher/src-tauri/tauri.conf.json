{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "foxkit",
  "version": "0.1.0",
  "identifier": "dev.foxkit.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "bar", "url": "index.html", "title": "foxkit",
        "width": 680, "height": 90, "decorations": false, "alwaysOnTop": true,
        "skipTaskbar": true, "resizable": false, "transparent": false, "visible": false, "focus": false
      },
      {
        "label": "main", "url": "main.html", "title": "foxkit",
        "width": 960, "height": 640, "minWidth": 640, "minHeight": 420, "visible": false, "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["foxkit.exe"]
  }
}

{
  "schema": 1,
  "commands": [
    {
      "name": "version", "title": "Phiên bản", "description": "Phiên bản foxkit", "category": "core",
      "args": [], "flags": [], "admin": false, "longRunning": false, "dryRun": false, "output": "kv"
    },
    {
      "name": "manifest", "title": "Manifest", "description": "Danh sách lệnh cho launcher", "category": "core",
      "args": [], "flags": [], "admin": false, "longRunning": false, "dryRun": false, "output": "text"
    },
    {
      "name": "uuid", "title": "Sinh UUID", "description": "Sinh UUID v4 hoặc v7", "category": "dev",
      "args": [],
      "flags": [
        { "name": "v", "type": "enum", "options": ["4", "7"], "default": "4", "label": "Phiên bản" },
        { "name": "count", "type": "int", "default": 1, "min": 1, "max": 1000, "label": "Số lượng" },
        { "name": "upper", "type": "bool", "default": false, "label": "Chữ hoa" },
        { "name": "no-dash", "type": "bool", "default": false, "label": "Bỏ dấu gạch" }
      ],
      "admin": false, "longRunning": false, "dryRun": false, "output": "text",
      "examples": [
        { "cmd": "uuid --v 7 --count 5", "desc": "5 UUID v7 theo thứ tự thời gian" },
        { "cmd": "uuid --upper --no-dash", "desc": "UUID chữ hoa, không dấu gạch" }
      ]
    },
    {
      "name": "pass", "title": "Sinh mật khẩu", "description": "Sinh mật khẩu/chuỗi ngẫu nhiên an toàn", "category": "dev",
      "args": [],
      "flags": [
        { "name": "len", "type": "int", "default": 24, "min": 4, "max": 1024, "label": "Độ dài" },
        { "name": "count", "type": "int", "default": 1, "min": 1, "max": 100, "label": "Số lượng" },
        { "name": "charset", "type": "enum", "options": ["all", "alnum", "alpha", "num", "hex"], "default": "all", "label": "Bộ ký tự" },
        { "name": "no-ambiguous", "type": "bool", "default": false, "label": "Bỏ ký tự dễ nhầm" }
      ],
      "admin": false, "longRunning": false, "dryRun": false, "output": "text",
      "examples": [
        { "cmd": "pass --len 64 --charset hex", "desc": "Chuỗi hex 64 ký tự" },
        { "cmd": "pass --count 3 --no-ambiguous", "desc": "3 mật khẩu, bỏ ký tự dễ nhầm" }
      ]
    },
    {
      "name": "hash", "title": "Tính hash", "description": "Tính md5/sha1/sha256/sha512/crc32 của file hoặc chuỗi", "category": "dev",
      "args": [ { "name": "file", "type": "file", "required": false, "multiple": true, "label": "File" } ],
      "flags": [
        { "name": "algo", "type": "enum", "options": ["md5", "sha1", "sha256", "sha512", "crc32"], "default": "sha256", "label": "Thuật toán" },
        { "name": "all", "type": "bool", "default": false, "label": "Tất cả thuật toán" },
        { "name": "text", "type": "string", "label": "Chuỗi" },
        { "name": "check", "type": "string", "label": "Hash cần so" }
      ],
      "admin": false, "longRunning": false, "dryRun": false, "output": "table",
      "examples": [
        { "cmd": "hash --text abc --all", "desc": "Hash chuỗi bằng mọi thuật toán" },
        { "cmd": "hash setup.exe --check 9f86d0", "desc": "Kiểm tra checksum file tải về" }
      ]
    },
    {
      "name": "enc", "title": "Encode / Decode", "description": "base64, base64url, hex, url, html", "category": "dev",
      "args": [
        { "name": "mode", "type": "enum", "options": ["base64", "base64url", "hex", "url", "html"], "required": true, "label": "Kiểu" },
        { "name": "text", "type": "text", "required": false, "label": "Nội dung" }
      ],
      "flags": [
        { "name": "decode", "type": "bool", "default": false, "label": "Decode" },
        { "name": "file", "type": "file", "label": "Từ file" }
      ],
      "admin": false, "longRunning": false, "dryRun": false, "output": "text",
      "examples": [
        { "cmd": "enc base64 \"Xin chào\"", "desc": "Mã hóa base64" },
        { "cmd": "enc base64 -d WGluIGNow6Bv", "desc": "Giải mã base64" }
      ]
    },
    {
      "name": "ts", "title": "Chuyển timestamp", "description": "Unix timestamp ↔ ngày giờ, nhiều múi giờ", "category": "dev",
      "args": [ { "name": "value", "type": "string", "required": false, "label": "Timestamp hoặc ngày giờ" } ],
      "flags": [ { "name": "tz", "type": "string", "default": "Local", "label": "Múi giờ" } ],
      "admin": false, "longRunning": false, "dryRun": false, "output": "kv",
      "examples": [
        { "cmd": "ts 1763287727 --tz Asia/Ho_Chi_Minh", "desc": "Timestamp sang giờ Việt Nam" },
        { "cmd": "ts \"2026-11-16 19:08:47\"", "desc": "Ngày giờ sang timestamp" }
      ]
    },
    {
      "name": "case", "title": "Đổi kiểu chữ", "description": "camel, snake, kebab, studly, slug tiếng Việt...", "category": "dev",
      "args": [
        { "name": "mode", "type": "enum", "options": ["all", "camel", "snake", "kebab", "studly", "title", "upper", "lower", "slug", "constant"], "required": true, "label": "Kiểu" },
        { "name": "text", "type": "string", "required": true, "label": "Chuỗi" }
      ],
      "flags": [], "admin": false, "longRunning": false, "dryRun": false, "output": "kv",
      "examples": [
        { "cmd": "case slug \"Đơn hàng mới\"", "desc": "Slug bỏ dấu tiếng Việt" },
        { "cmd": "case all userName", "desc": "Mọi kiểu một lượt" }
      ]
    },
    {
      "name": "port", "title": "Kiểm tra port", "description": "Xem process nào đang chiếm port, có thể kill", "category": "dev",
      "args": [ { "name": "port", "type": "int", "required": false, "min": 1, "max": 65535, "label": "Port" } ],
      "flags": [
        { "name": "kill", "type": "bool", "default": false, "label": "Kill process", "confirm": "Kill process đang dùng port này?" },
        { "name": "list", "type": "bool", "default": false, "label": "Liệt kê mọi port đang mở" }
      ],
      "admin": false, "longRunning": false, "dryRun": false, "output": "kv",
      "examples": [
        { "cmd": "port 8000", "desc": "Ai đang chiếm port 8000" },
        { "cmd": "port 8000 --kill", "desc": "Kill process đang chiếm port 8000" },
        { "cmd": "port --list", "desc": "Mọi port đang LISTEN" }
      ]
    },
    {
      "name": "env diff", "title": "So sánh .env", "description": "So .env với .env.example: thiếu, thừa, rỗng", "category": "dev",
      "args": [ { "name": "dir", "type": "dir", "required": false, "label": "Thư mục dự án" } ],
      "flags": [
        { "name": "file", "type": "string", "default": ".env", "label": "File env" },
        { "name": "example", "type": "string", "default": ".env.example", "label": "File mẫu" }
      ],
      "admin": false, "longRunning": false, "dryRun": false, "output": "kv",
      "examples": [ { "cmd": "env diff D:\\Projects\\shop-api", "desc": "Biến .env còn thiếu so với .env.example" } ]
    },
    {
      "name": "env get", "title": "Đọc biến .env", "description": "Đọc giá trị một key trong .env", "category": "dev",
      "args": [
        { "name": "key", "type": "string", "required": true, "label": "Key" },
        { "name": "dir", "type": "dir", "required": false, "label": "Thư mục dự án" }
      ],
      "flags": [
        { "name": "file", "type": "string", "default": ".env", "label": "File env" },
        { "name": "show", "type": "bool", "default": false, "label": "Hiện giá trị bí mật" }
      ],
      "admin": false, "longRunning": false, "dryRun": false, "output": "kv",
      "examples": [ { "cmd": "env get DB_PASSWORD --show", "desc": "Đọc giá trị bí mật (không che)" } ]
    },
    {
      "name": "size", "title": "Dung lượng thư mục", "description": "Thư mục/file nào chiếm nhiều dung lượng nhất", "category": "life",
      "args": [ { "name": "dir", "type": "dir", "required": false, "label": "Thư mục" } ],
      "flags": [
        { "name": "top", "type": "int", "default": 20, "min": 1, "max": 500, "label": "Số mục" },
        { "name": "files", "type": "bool", "default": false, "label": "Liệt kê file lớn nhất" }
      ],
      "admin": false, "longRunning": false, "dryRun": false, "output": "table",
      "examples": [
        { "cmd": "size C:\\ --top 10", "desc": "10 thư mục nặng nhất ở ổ C" },
        { "cmd": "size D:\\Projects --files --top 30", "desc": "30 file lớn nhất trong D:\\Projects" }
      ]
    },
    {
      "name": "dup", "title": "Tìm file trùng", "description": "Tìm file trùng nội dung, báo dung lượng lãng phí", "category": "life",
      "args": [ { "name": "dir", "type": "dir", "required": true, "multiple": true, "label": "Thư mục" } ],
      "flags": [
        { "name": "min-size", "type": "string", "default": "1KB", "label": "Bỏ file nhỏ hơn" },
        { "name": "ext", "type": "list", "label": "Chỉ đuôi file (jpg,png)" },
        { "name": "workers", "type": "int", "min": 1, "max": 64, "label": "Số luồng" },
        { "name": "include-hidden", "type": "bool", "default": false, "label": "Gồm file ẩn" }
      ],
      "admin": false, "longRunning": false, "dryRun": false, "output": "table",
      "examples": [ { "cmd": "dup D:\\Photos E:\\Backup --ext jpg,png", "desc": "Ảnh trùng giữa hai thư mục" } ]
    },
    {
      "name": "rename", "title": "Đổi tên hàng loạt", "description": "Tìm-thay thế, đổi kiểu chữ, đánh số tên file", "category": "life",
      "args": [ { "name": "dir", "type": "dir", "required": true, "label": "Thư mục" } ],
      "flags": [
        { "name": "find", "type": "string", "label": "Tìm" },
        { "name": "replace", "type": "string", "label": "Thay bằng" },
        { "name": "regex", "type": "bool", "default": false, "label": "Regex" },
        { "name": "ignore-case", "type": "bool", "default": false, "label": "Không phân biệt hoa thường" },
        { "name": "with-ext", "type": "bool", "default": false, "label": "Áp dụng cả đuôi file" },
        { "name": "case", "type": "enum", "options": ["lower", "upper", "slug", "snake", "kebab"], "label": "Đổi kiểu chữ" },
        { "name": "number", "type": "string", "label": "Mẫu đánh số ({n:3})" },
        { "name": "sort", "type": "enum", "options": ["name", "date", "size"], "default": "name", "label": "Sắp xếp khi đánh số" },
        { "name": "start", "type": "int", "default": 1, "label": "Số bắt đầu" },
        { "name": "ext", "type": "list", "label": "Chỉ đuôi file" },
        { "name": "recursive", "type": "bool", "default": false, "label": "Gồm thư mục con" },
        { "name": "dirs", "type": "bool", "default": false, "label": "Đổi tên cả thư mục" },
        { "name": "apply", "type": "bool", "default": false, "label": "Thực hiện" }
      ],
      "admin": false, "longRunning": false, "dryRun": true, "output": "table",
      "examples": [
        { "cmd": "rename D:\\Photos\\Trip --find IMG_ --replace trip_", "desc": "Xem trước đổi IMG_ thành trip_" },
        { "cmd": "rename D:\\Photos\\Trip --number \"DaLat_{n:3}\" --sort date", "desc": "Đánh số theo ngày sửa" }
      ]
    },
    {
      "name": "find", "title": "Tìm file", "description": "Tìm file theo tên, đuôi, kích thước, ngày, nội dung", "category": "life",
      "args": [
        { "name": "pattern", "type": "string", "required": false, "label": "Tên (hỗ trợ *, ?)" },
        { "name": "dir", "type": "dir", "required": false, "label": "Thư mục" }
      ],
      "flags": [
        { "name": "ext", "type": "list", "label": "Đuôi file" },
        { "name": "type", "type": "enum", "options": ["f", "d", "a"], "default": "f", "label": "Loại" },
        { "name": "larger", "type": "string", "label": "Lớn hơn" },
        { "name": "smaller", "type": "string", "label": "Nhỏ hơn" },
        { "name": "newer", "type": "string", "label": "Sửa trong vòng" },
        { "name": "older", "type": "string", "label": "Cũ hơn" },
        { "name": "content", "type": "string", "label": "Chứa nội dung" },
        { "name": "ignore-case", "type": "bool", "default": true, "label": "Không phân biệt hoa thường" },
        { "name": "max", "type": "int", "default": 200, "min": 1, "max": 10000, "label": "Tối đa" },
        { "name": "hidden", "type": "bool", "default": false, "label": "Gồm file ẩn" }
      ],
      "admin": false, "longRunning": false, "dryRun": false, "output": "table",
      "examples": [
        { "cmd": "find \"hop dong\" D:\\Docs --ext pdf", "desc": "PDF có tên 'hợp đồng' (không cần gõ dấu)" },
        { "cmd": "find \"*.php\" D:\\Projects\\shop --content CouponController", "desc": "Tìm trong nội dung file PHP" }
      ]
    },
    {
      "name": "temp", "title": "Dọn thư mục tạm", "description": "Xem và dọn file tạm cũ của user", "category": "life",
      "args": [],
      "flags": [
        { "name": "older", "type": "string", "default": "7d", "label": "Cũ hơn" },
        { "name": "apply", "type": "bool", "default": false, "label": "Xóa thật", "confirm": "Xóa các file tạm cũ?" }
      ],
      "admin": false, "longRunning": false, "dryRun": true, "output": "kv",
      "examples": [ { "cmd": "temp --older 30d", "desc": "Xem trước dọn file tạm cũ hơn 30 ngày" } ]
    },
    {
      "name": "prune", "title": "Dọn node_modules/vendor", "description": "Xóa node_modules, vendor của dự án lâu không dùng", "category": "dev",
      "args": [ { "name": "dir", "type": "dir", "required": true, "label": "Thư mục dự án" } ],
      "flags": [
        { "name": "target", "type": "list", "default": "node_modules,vendor", "label": "Loại thư mục" },
        { "name": "older", "type": "string", "default": "30d", "label": "Không đụng tới hơn" },
        { "name": "depth", "type": "int", "default": 4, "min": 1, "max": 10, "label": "Độ sâu" },
        { "name": "apply", "type": "bool", "default": false, "label": "Xóa thật", "confirm": "Xóa các thư mục đã liệt kê?" }
      ],
      "admin": false, "longRunning": false, "dryRun": true, "output": "table",
      "examples": [ { "cmd": "prune D:\\Projects --older 90d", "desc": "Xem trước dự án không đụng tới hơn 90 ngày" } ]
    },
    {
      "name": "todo", "title": "Liệt kê TODO", "description": "Tìm TODO/FIXME/HACK trong mã nguồn", "category": "dev",
      "args": [ { "name": "dir", "type": "dir", "required": false, "label": "Thư mục dự án" } ],
      "flags": [
        { "name": "tags", "type": "list", "default": "TODO,FIXME,HACK,XXX", "label": "Tag" },
        { "name": "ext", "type": "list", "label": "Đuôi file" },
        { "name": "author", "type": "bool", "default": false, "label": "Kèm tác giả (git blame)" }
      ],
      "admin": false, "longRunning": false, "dryRun": false, "output": "table",
      "examples": [ { "cmd": "todo @dir --tags FIXME --author", "desc": "FIXME trong dự án đang mở, kèm tác giả" } ]
    },
    {
      "name": "ps", "title": "Danh sách process", "description": "Process đang chạy, sắp theo RAM, gộp theo tên", "category": "system",
      "args": [ { "name": "filter", "type": "string", "required": false, "label": "Lọc theo tên" } ],
      "flags": [
        { "name": "sort", "type": "enum", "options": ["mem", "name", "pid"], "default": "mem", "label": "Sắp xếp" },
        { "name": "top", "type": "int", "default": 30, "min": 0, "label": "Số dòng (0 = tất cả)" },
        { "name": "group", "type": "bool", "default": false, "label": "Gộp theo tên" }
      ],
      "admin": false, "longRunning": false, "dryRun": false, "output": "table",
      "examples": [ { "cmd": "ps --group --top 10", "desc": "10 nhóm process ăn RAM nhiều nhất" }, { "cmd": "ps node", "desc": "Mọi process node" } ]
    },
    {
      "name": "kill", "title": "Kill process", "description": "Kill process theo PID hoặc tên", "category": "system",
      "args": [ { "name": "target", "type": "string", "required": true, "multiple": true, "label": "PID hoặc tên" } ],
      "flags": [ { "name": "tree", "type": "bool", "default": false, "label": "Kill cả process con" } ],
      "admin": false, "confirm": "Kill các process này?", "longRunning": false, "dryRun": false, "output": "kv",
      "examples": [ { "cmd": "kill node --tree", "desc": "Kill mọi node.exe cùng process con" } ]
    }
  ]
}
